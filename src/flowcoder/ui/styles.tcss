/* TUI 样式表（P5.5 视觉重构）。
 *
 * 设计语言：现代深色 CLI（参考 Claude Code / Codex 风格）——
 * 近黑蓝底、紫色主强调、圆角输入框、消息左强调条、克制的信息层级。
 * DOM 结构与功能逻辑零改动，全部通过既有 class/id 选择器实现。
 */

Screen {
    background: $background;
}

/* --- 标题栏 --- */

#title-bar {
    dock: top;
    width: 100%;
    height: 3;
    padding: 0 1;
    background: $background;
}

/* --- Provider 选择 --- */

#provider-select {
    align: center middle;
    width: 100%;
    height: 1fr;
}

#select-label {
    text-align: center;
    width: 100%;
    height: auto;
    margin-top: 2;
    text-style: bold;
    color: $text;
}

#provider-list {
    width: 60;
    height: auto;
    max-height: 16;
    margin: 1 2;
    border: round $primary 60%;
    background: $surface;
}

/* --- 聊天区 --- */

#chat-area {
    height: 1fr;
    min-height: 18;
    padding: 1 2;
    scrollbar-background: $surface;
    scrollbar-color: #2E2E3A;
    scrollbar-color-hover: #4A3F78;
    scrollbar-corner-color: $surface;
}

.message {
    padding: 0 2;
    margin: 0;
    width: 100%;
    height: auto;
}

.user-row {
    height: auto;
    width: 100%;
    margin-top: 1;
}

/* 用户消息：左侧主色强调条 + 轻微底色（现代聊天界面惯例） */
.user-message {
    color: $text;
    background: #17171f;
    border-left: thick $primary;
    padding: 0 1 0 2;
}

.ai-row {
    height: auto;
    width: 100%;
}

.ai-message {
    color: $text;
}

.error-message {
    color: $error;
    text-style: bold;
    background: #1f1418;
    border-left: thick $error;
    padding: 0 1 0 2;
    margin-top: 1;
}

.system-message {
    color: $text-muted;
    text-style: italic;
    padding: 0 2;
}

/* --- 工具调用块 --- */

.tool-block {
    padding: 0 2;
    width: auto;
    height: auto;
    color: $text;
    border-left: outer #2E2E3A;
    margin: 0 0 0 1;
}

.tool-block-loading {
    color: $text-muted;
    text-style: italic;
}

.tool-block-error {
    color: $error;
    border-left: outer $error 60%;
}

/* --- 思考展示 --- */

.thinking-done {
    color: $text-muted;
    text-style: italic;
}

/* --- 子 Agent 块 --- */

.subagent-block {
    color: $text;
    padding: 0 2;
    border-left: outer #3A3F6E;
    margin: 0 0 0 1;
}

/* --- 输入区 --- */

#spinner-live {
    height: 1;
    padding: 0 2;
    color: $primary;
}

#input-area {
    dock: bottom;
    height: auto;
    max-height: 20;
    padding: 1 2 0 2;
    background: $background;
}

/* 输入框：圆角描边，聚焦时亮起主色（现代 CLI 输入框惯例） */
#chat-input {
    height: auto;
    min-height: 3;
    max-height: 12;
    border: round #3A3F6E;
    padding: 0 1;
}

#chat-input:focus {
    border: round $primary;
}

#status-bar {
    height: auto;
    min-height: 1;
    width: 100%;
    padding: 0 1;
    background: $background;
}

#mode-label {
    width: auto;
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

#teammates-label {
    width: auto;
    height: 1;
    padding: 0 1;
}

#model-label {
    width: 1fr;
    height: 1;
    text-align: right;
    color: $text-muted;
}

/* --- Teammate 树 --- */

#teammate-tree {
    height: auto;
    padding: 0 2;
}

/* --- 计划审批对话框 --- */

PlanApprovalDialog {
    align: center middle;
}

#plan-dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $warning;
}

#plan-title {
    text-style: bold;
    text-align: center;
    padding: 0 0 1 0;
    color: $text;
}

#plan-dialog Button {
    width: 100%;
    margin: 0 0 1 0;
}

/* --- AskUser 对话框 --- */

AskUserDialog {
    align: center middle;
}

#askuser-dialog {
    width: 64;
    height: auto;
    max-height: 20;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#askuser-title {
    text-style: bold;
    text-align: center;
    padding: 0 0 1 0;
    color: $text;
}

#askuser-options {
    height: auto;
    max-height: 12;
}

/* --- 内联权限组件 --- */

#perm-inline {
    height: auto;
    padding: 0 0;
    margin: 0 0;
}

#perm-content {
    padding: 0 0;
    background: $surface;
    border: round $warning 60%;
}

/* --- 内联计划组件 --- */

#plan-inline {
    height: auto;
    padding: 0 0;
}

#plan-content {
    padding: 0 0;
    background: $surface;
    border: round $warning 60%;
}

/* --- 内联 AskUser 组件 --- */

#askuser-inline {
    height: auto;
    padding: 0 0;
}

#askuser-content {
    padding: 0 0;
    background: $surface;
    border: round $primary 60%;
}

/* --- 内联 Resume 组件 --- */

#resume-inline {
    height: auto;
    padding: 0 0;
}

#resume-content {
    padding: 0 0;
    background: $surface;
    border: round $primary 60%;
}
